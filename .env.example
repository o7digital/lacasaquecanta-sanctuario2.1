# Private accounts. Use separate PostgreSQL databases and secrets per environment.
DATABASE_URL=
BETTER_AUTH_SECRET=
# Optional verified transactional email sender (required for real enrolment/recovery).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Set to the first real administrator's email, after verifying it.
STAFF_BOOTSTRAP_EMAIL=
# Isolated fictional sandboxes; never enter real guest data in a demo.
DEMO_ENABLED=false
# Marketing provider must be confirmed by the hotel before activation.
NEWSLETTER_ENABLED=false
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
PUBLIC_NEWSLETTER_MANAGE_URL=
# Editorial content lives in this new repository and dedicated branch only.
CONTENT_BRANCH=codex/el-sanctuario-v2
# Optional canonical origin. The verified deployment origin is used otherwise.
PUBLIC_SITE_URL=https://el-sanctuario-21.vercel.app
# Keep previews and editorial samples out of search indexes.
PUBLIC_INDEXABLE=false
# Optional commercial Open-Meteo customer key; public endpoint is for noncommercial previews.
OPEN_METEO_API_KEY=
# Optional signed inbound hotel reservation adapter. No PMS is assumed.
INBOUND_STAY_SECRET=
INBOUND_STAY_ACTOR_ID=
INBOUND_STAY_SOURCE=
INBOUND_STAY_OPERATION=
