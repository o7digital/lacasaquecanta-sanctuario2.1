# Newsletter deliberately awaits hotel validation. No addresses are collected until enabled.
NEWSLETTER_ENABLED=false
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
PUBLIC_NEWSLETTER_MANAGE_URL=
# Editorial content lives in this new repository and dedicated branch only.
CONTENT_BRANCH=codex/el-sanctuario
# Optional canonical origin. The verified deployment origin is used otherwise.
PUBLIC_SITE_URL=https://el-sanctuario-21.vercel.app
# Keep previews and editorial samples out of search indexes.
PUBLIC_INDEXABLE=false
# Optional commercial Open-Meteo customer key; public endpoint is for noncommercial previews.
OPEN_METEO_API_KEY=
