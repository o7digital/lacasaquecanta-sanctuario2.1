---
import Layout from '../../../layouts/Layout.astro';
import { getContent, publicContent, renderBody } from '../../../lib/content';
import { articlePath, categoryLabels, readingTime } from '../../../lib/schema';
import { journalMarkup, storyCard } from '../../../lib/presentation';
const lang = Astro.params.lang;
if (lang !== 'en' && lang !== 'es') return new Response('Not found', { status: 404 });
const content = publicContent(await getContent());
const article = content.articles.find(a => a.id === Astro.params.id);
if (!article) return new Response('Not found', { status: 404 });
const text = article.locales[lang];
const t = (en: string, es: string) => lang === 'en' ? en : es;
const sameFamily = (category: string) => category === article.category || ['chef','taste','recipe'].includes(article.category) && ['chef','taste','recipe'].includes(category);
const related = content.articles.filter(a => a.id !== article.id).sort((a,b) => Number(sameFamily(b.category)) - Number(sameFamily(a.category))).slice(0, 2);
const canonical = new URL(articlePath(lang, article.id), process.env.PUBLIC_SITE_URL || Astro.url.origin).href;
const structured = { '@context': 'https://schema.org', '@type': 'Article', headline: text.title, description: text.intro, datePublished: article.date, dateModified: article.updatedAt, author: { '@type': 'Organization', name: article.author[lang] }, image: new URL(article.image.src, canonical).href, inLanguage: lang, mainEntityOfPage: canonical, isAccessibleForFree: true };
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout lang={lang} title={`${text.title} — El Sanctuario`} description={text.intro} content={content} articleId={article.id}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  <a class="skip" href="#article">{t('Skip to the article', 'Saltar al artículo')}</a>
  <header class="reading-nav">
    <a class="mini-title" href={`/${lang}/`}>El Sanctuario</a>
    <nav aria-label={t('Article navigation', 'Navegación del artículo')}>
      <a class="language" href={articlePath(lang === 'en' ? 'es' : 'en', article.id)} hreflang={lang === 'en' ? 'es' : 'en'}>{lang.toUpperCase()} / {lang === 'en' ? 'ES' : 'EN'}</a>
      <button class="saved-trigger">{t('My notebook', 'Mi cuaderno')} <span class="saved-count">0</span></button>
      <button id="search-trigger" aria-label={t('Search', 'Buscar')}><svg class="icon"><use href="#i-search" /></svg></button>
    </nav>
  </header>
  <main id="article" class="reading-page">
    <figure class="reading-photo"><img src={article.image.src} alt={article.image.alt[lang]} fetchpriority="high" /><figcaption>{article.image.credit}</figcaption></figure>
    <article class="reader-body" data-edition-updated={article.updatedAt}>
      <a href={`/${lang}/#journal`} class="eyebrow">{categoryLabels[article.category][lang]}</a>
      <h1>{text.title}</h1><p class="reader-lead">{text.intro}</p>
      <p class="reader-meta">{article.author[lang]} · <time datetime={article.date}>{article.date}</time> · {readingTime(text.body)} {t('MIN READ', 'MIN DE LECTURA')}<br />{t('Updated', 'Actualizado')}: <time datetime={article.updatedAt}>{article.updatedAt}</time></p>
      {article.status === 'sample' && <aside class="sample-note">{t('Editorial sample for hotel approval. This text is not an interview or a statement from the chef. Recipes are proposals, not official hotel recipes.', 'Muestra editorial pendiente de aprobación del hotel. No es una entrevista ni una declaración del chef. Las recetas son propuestas, no recetas oficiales del hotel.')}</aside>}
      <p id="offline-notice" class="offline-note" role="status" hidden>{t('Offline copy. Edition last updated', 'Copia sin conexión. Edición actualizada')}: {article.updatedAt}.</p>
      <div class="article-prose" set:html={renderBody(text.body)} />
      {article.recipe&&<section class="recipe-box"><h2>{t('The recipe to keep','La receta para guardar')}</h2><p>{article.recipe.servings} {t('servings','porciones')}</p><h3>{t('Ingredients','Ingredientes')}</h3><ul>{article.recipe.ingredients[lang].split('\n').filter(Boolean).map(line=><li>{line}</li>)}</ul><h3>{t('Method','Preparación')}</h3><ol>{article.recipe.steps[lang].split('\n').filter(Boolean).map(line=><li>{line}</li>)}</ol>{article.recipe.validatedDietary.length>0&&<p>{t('Validated dietary options','Opciones alimentarias validadas')}: {article.recipe.validatedDietary.join(', ')}</p>}</section>}
      {article.series==='chef-letters'&&<p><a href={`/${lang}/chef-letters/`}>{t('All letters from the kitchen','Todas las cartas desde la cocina')}</a></p>}
      {article.category === 'chef' && content.articles.some(a => a.id === 'avocado-lime') && <p><a class="text-link" href={articlePath(lang,'avocado-lime')}>{t('The recipe, ready to keep in your notebook', 'La receta, lista para guardar en tu cuaderno')}</a></p>}
      <a class="reader-source" href={article.source} target="_blank" rel="noopener">{t('Explore the official hotel page', 'Explorar la página oficial del hotel')}</a>
      <div class="reader-actions"><button class="pill dark" data-save={article.id} aria-pressed="false">{t('Keep this story', 'Guardar esta historia')}</button><button class="text-link" id="share-story">{t('Share this story', 'Compartir esta historia')}</button><button class="text-link" data-plan-from-story={article.id}>{t('Make it part of my stay', 'Incluirlo en mi estancia')}</button></div>
    </article>
    <section class="related-stories wrap"><h2>{t('A little more to linger over.', 'Un poco más para disfrutar.')}</h2><div class="related-grid" set:html={related.map((a,i) => storyCard(a, lang, i + 1)).join('')} /></section>
  </main>
  <footer class="reading-footer"><a href={`/${lang}/`}>El Sanctuario</a> · La Casa Que Canta · <a href={`/${lang}/#circle`}>{t('Stay connected', 'Sigamos cerca')}</a></footer>
  <Fragment set:html={journalMarkup(content, lang, article.id)} />
</Layout>
