---
import Portal from '../../layouts/Portal.astro';
import {getContent,publicContent,renderBody} from '../../lib/content';
import {categoryLabels,categories,articlePath,type Locale} from '../../lib/schema';
import {eventState,plusDays,localDay} from '../../lib/travel';
import {storyCard} from '../../lib/presentation';
import Weather from '../../components/Weather';
import Explore from '../../components/Explore';
import RequestForm from '../../components/RequestForm';
import SaveButton from '../../components/SaveButton';
import Account from '../../components/Account';
import AuthForm from '../../components/AuthForm';
import OfferAccess from '../../components/OfferAccess';
import {actorFor} from '../../lib/auth';
import {account} from '../../lib/circle';
import {offerEligibility} from '../../lib/circle-schema';
const lang=Astro.params.lang as Locale;
if(!['en','es'].includes(lang))return new Response('Not found',{status:404});
const t=(en:string,es:string)=>lang==='en'?en:es;
const path=(Astro.params.section||'').replace(/\/$/,''),[section,slug,extra]=path.split('/');
const rawContent=await getContent();
const content=publicContent(rawContent);
const edition=section==='editions'?content.editions.find(e=>e.id===slug):undefined;
const experience=section==='experiences'?content.experiences.find(e=>e.id===slug):undefined;
const event=section==='events'?content.events.find(e=>e.id===slug):undefined;
const candidate=section==='offers'&&slug?rawContent.offers.find(e=>e.id===slug&&e.status!=='draft'):undefined;
const restricted=Boolean(candidate&&(candidate.membersOnly||candidate.tiers.length));
let offer=candidate;
if(restricted){try{const actor=await actorFor(Astro.request);const info=await account(actor);if(actor.demo||offerEligibility(candidate!,localDay(),info.membership)!=='eligible')offer=undefined;}catch{offer=undefined;}}
const valid=(!slug&&['archives','explore','offers','weddings','special-moments','chef-letters','login','join'].includes(section))||section==='account'&&(!slug||['profile','stays','card','points','notebook','requests'].includes(slug))||section==='categories'&&categories.includes(slug as any)||edition||experience||event||candidate;
if(!valid||extra&&!(section==='account'&&slug==='stays'&&/^[a-f0-9-]{36}$/.test(extra)))return new Response('Not found',{status:404});
const isPrivate=section==='account'||section==='login'||restricted;
Astro.response.headers.set('Cache-Control',isPrivate?'private, no-store':'no-store');
const title=edition?.title[lang]||experience?.title[lang]||event?.title[lang]||offer?.title[lang]||({archives:t('The archive.','El archivo.'),explore:t('The bay, at your own pace.','La bahía, a tu ritmo.'),offers:t('A reason to return.','Un motivo para volver.'),weddings:t('A day, entirely your own.','Un día enteramente tuyo.'),'special-moments':t('The moments we keep.','Los momentos que guardamos.'),'chef-letters':t('Letters from the kitchen.','Cartas desde la cocina.'),login:t('Welcome back.','Qué gusto verte.'),join:'El Sanctuario Circle',account:t('Your own corner of the Pacific.','Tu rincón del Pacífico.'),categories:categoryLabels[slug as keyof typeof categoryLabels]?.[lang]}[section]||'El Sanctuario');
const articles=edition?content.articles.filter(a=>edition.articleIds.includes(a.id)):section==='categories'?content.articles.filter(a=>a.category===slug):section==='chef-letters'?content.articles.filter(a=>a.series==='chef-letters'||a.category==='chef'):section==='weddings'?content.articles.filter(a=>a.category==='weddings'):section==='special-moments'?content.articles.filter(a=>a.category==='moments'):[];
const sample=edition?.status==='sample'||experience?.status==='sample'||offer?.status==='sample';
---
<Portal lang={lang} title={title} noindex={isPrivate||sample}>
 <div class="page-heading"><p class="eyebrow">EL SANCTUARIO · {edition?`${t('ISSUE','NÚMERO')} ${edition.number}`:t('LA CASA QUE CANTA','LA CASA QUE CANTA')}</p><h1>{title}</h1>{edition&&<p>{edition.period[lang]} · {edition.theme[lang]}</p>}</div>
 {sample&&<p class="sample-note">{t('Editorial sample for hotel approval. No offer, availability or quoted statement is implied.','Muestra editorial pendiente de aprobación del hotel. No implica ofertas, disponibilidad ni declaraciones reales.')}</p>}
 {section==='archives'&&<><p class="page-intro">{t('A place to return to the stories. Sample issues are clearly marked until the house publishes its first edition.','Un lugar para volver a las historias. Los números de muestra se identifican hasta que la casa publique su primera edición.')}</p><div class="issue-grid">{content.editions.map(e=><a class="issue-card" href={`/${lang}/editions/${e.id}/`}><img src={e.image} alt=""/><div><span class="eyebrow">{t('ISSUE','NÚMERO')} {e.number} · {e.period[lang]}</span><h2>{e.title[lang]}</h2><p>{e.intro[lang]}</p><small>{e.status==='sample'?t('Editorial sample','Muestra editorial'):t('Published edition','Edición publicada')}</small></div></a>)}</div></>}
 {edition&&<><img class="edition-landscape" src={edition.image} alt=""/><p class="page-intro">{edition.intro[lang]}</p><section class="contents-box"><h2>{t('In this issue','En este número')}</h2><ol>{articles.map(a=><li><a href={articlePath(lang,a.id)}><span>{categoryLabels[a.category][lang]}</span>{a.locales[lang].title}</a></li>)}</ol></section></>}
 {section==='categories'&&<nav class="category-links" aria-label={t('Journal sections','Secciones de la revista')}>{categories.map(c=><a aria-current={c===slug?'page':undefined} href={`/${lang}/categories/${c}/`}>{categoryLabels[c][lang]}</a>)}</nav>}
 {['weddings','special-moments'].includes(section)&&<><img class="edition-landscape" src={section==='weddings'?'/assets/hero.jpg':'/assets/sunset.jpg'} alt={t('La Casa Que Canta on the Pacific coast','La Casa Que Canta en la costa del Pacífico')}/><p class="page-intro">{section==='weddings'?t('A ceremony, a table, your favourite people. Begin with the story you would like to tell. Spaces, capacities and private arrangements are confirmed individually by the house.','Una ceremonia, una mesa, tus personas favoritas. Comienza con la historia que quieres contar. La casa confirma individualmente espacios, aforos y servicios privados.'):t('A birthday, a honeymoon, an anniversary. Or simply being together again. Tell the house what matters, with a private contact for a surprise.','Un cumpleaños, una luna de miel, un aniversario. O simplemente volver a estar juntos. Cuenta lo que importa, con un contacto privado para una sorpresa.')}</p></>}
 {articles.length>0&&<div class="catalogue-grid story-collection" set:html={articles.map((a,i)=>storyCard(a,lang,i)).join('')}/>}
 {(section==='editions'||section==='categories'||section==='chef-letters')&&!articles.length&&<p class="empty-state">{t('The next story is being prepared.','La próxima historia se está preparando.')}</p>}
 {section==='explore'&&<><Weather lang={lang} client:load/><Explore content={content} lang={lang} client:load/></>}
 {experience&&<><img class="edition-landscape" src={experience.image} alt={experience.title[lang]}/><p class="page-intro">{experience.intro[lang]}</p><article class="article-prose detail-prose" set:html={renderBody(experience.body[lang])}/><dl class="detail-grid">{[[t('Location','Lugar'),experience.location[lang]],[t('Provider','Prestador'),experience.provider[lang]],[t('Duration','Duración'),experience.duration[lang]],[t('Languages','Idiomas'),experience.languages[lang]],[t('Level','Nivel'),experience.level[lang]],[t('Practical details','Información práctica'),experience.practical[lang]],[t('Price','Precio'),experience.price!==undefined?`${experience.price} ${experience.currency}`:t('Request information','Solicita información')],[t('Inclusions','Incluye'),experience.inclusions[lang]],[t('Booking conditions','Condiciones de reserva'),experience.conditions[lang]],[t('Cancellation','Cancelación'),experience.cancellation[lang]]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="status-tag">{experience.availability==='on_request'?t('On request — no time confirmed','Por consultar — sin horario confirmado'):experience.availability==='unavailable'?t('Currently unavailable','No disponible actualmente'):experience.start}</p>{experience.availability==='confirmed'&&experience.start&&<a class="pill" href={`/api/experiences/${experience.id}.ics?lang=${lang}`}>{t('Add confirmed date to calendar','Añadir fecha confirmada al calendario')}</a>}<SaveButton lang={lang} kind="experience" itemId={experience.id} client:load/>{experience.availability!=='unavailable'&&<RequestForm lang={lang} kind="experience" itemId={experience.id} client:load/>}</>}
 {event&&<><p class="page-intro">{event.description[lang]}</p><dl class="detail-grid"><div><dt>{t('Dates','Fechas')}</dt><dd>{event.start} — {plusDays(event.end,-1)}</dd></div><div><dt>{t('Place','Lugar')}</dt><dd>{event.location[lang]}</dd></div><div><dt>{t('Local time','Hora local')}</dt><dd>{event.startTime||t('Confirm with the organiser','Confirma con el organizador')} · America/Mexico_City</dd></div><div><dt>{t('Status','Estado')}</dt><dd>{event.status==='cancelled'?t('Cancelled','Cancelado'):eventState(event)==='past'?t('Past event','Evento pasado'):t('Upcoming','Próximamente')}</dd></div></dl><p><a href={event.source} target="_blank" rel="noopener">{t('Organiser & official programme','Organizador y programa oficial')}</a> · {t('Last checked','Última revisión')}: {event.verifiedAt}</p><div class="button-row"><a class="pill" href={`/api/events/${event.id}.ics?lang=${lang}`}>{t('Add to calendar','Añadir al calendario')}</a><SaveButton lang={lang} kind="event" itemId={event.id} client:load/></div><p class="caption">{event.context==='bay'?t('Independent event. Confirm details with the organiser.','Evento independiente. Confirma los detalles con el organizador.'):t('Hotel event. Confirm with the house.','Evento del hotel. Confirma con la casa.')}</p></>}
 {section==='offers'&&!slug&&<><p class="page-intro">{t('Only hotel-approved offers appear here, with their dates and conditions. A return project is always yours to begin.','Aquí solo aparecen ofertas aprobadas por el hotel, con fechas y condiciones. Siempre puedes comenzar un proyecto de regreso.')}</p>{!content.offers.length?<div class="empty-state"><h2>{t('Your next chapter is open.','Tu próximo capítulo está abierto.')}</h2><p>{t('The house has not published an offer yet. Explore the journal or ask about your preferred dates.','La casa aún no ha publicado una oferta. Explora la revista o consulta por tus fechas preferidas.')}</p><a class="pill dark" href={`/${lang}/account/stays/`}>{t('Prepare my return','Preparar mi regreso')}</a></div>:<div class="catalogue-grid">{content.offers.map(o=><a class="catalogue-card" href={`/${lang}/offers/${o.id}/`}><img src={o.image} alt=""/><div><h2>{o.title[lang]}</h2><p>{o.intro[lang]}</p><p>{o.bookingStart} — {o.bookingEnd}</p></div></a>)}</div>}</>}
 {candidate&&!offer&&<div class="empty-state"><p>{t("This offer is reserved for eligible members. Sign in to check access.","Esta oferta está reservada a miembros elegibles. Inicia sesión para comprobar el acceso.")}</p><a class="pill" href={`/${lang}/login/`}>{t("Sign in","Iniciar sesión")}</a></div>}
 {offer&&<><img class="edition-landscape" src={offer.image} alt=""/><p class="page-intro">{offer.intro[lang]}</p><article class="article-prose detail-prose" set:html={renderBody(offer.body[lang])}/><dl class="detail-grid"><div><dt>{t('Booking period','Periodo de reserva')}</dt><dd>{offer.bookingStart} — {offer.bookingEnd}</dd></div><div><dt>{t('Stay period','Periodo de estancia')}</dt><dd>{offer.stayStart} — {offer.stayEnd}</dd></div><div><dt>{t('Conditions','Condiciones')}</dt><dd>{offer.conditions[lang]}</dd></div><div><dt>{t('Exclusions','Exclusiones')}</dt><dd>{offer.exclusions[lang]}</dd></div><div><dt>{t('Price','Precio')}</dt><dd>{offer.price!==undefined?`${offer.price} ${offer.currency}`:t('On request','Por consultar')}</dd></div></dl>{localDay()>offer.bookingEnd?<p class="sample-note">{t('This offer has expired.','Esta oferta ha caducado.')}</p>:<><SaveButton lang={lang} kind="offer" itemId={offer.id} client:load/><OfferAccess lang={lang} offer={offer} client:load/></>}</>}
 {['weddings','special-moments'].includes(section)&&<RequestForm lang={lang} kind={section==='weddings'?'wedding':'moment'} client:load/>}
 {section==='join'&&<section class="join-circle"><p class="page-intro">{t('Keep the connection between stays. Your notebook, your wishes and your conversations with the house, together in one private space.','Mantén el vínculo entre estancias. Tu cuaderno, tus deseos y tus conversaciones con la casa, juntos en un espacio privado.')}</p><div class="tier-preview">{['Gold','Platinum','Black'].map(tier=><div class={`member-card ${tier.toLowerCase()}`}><span>EL SANCTUARIO CIRCLE</span><h2>{tier}</h2><p>{t('Visual preview','Vista previa visual')}</p></div>)}</div><p>{t('Membership level, points and benefits are assigned by the house under its activated programme rules. Creating an account does not promise a tier or a discount.','La casa asigna nivel, puntos y beneficios según las reglas activadas del programa. Crear una cuenta no promete un nivel ni un descuento.')}</p><a class="pill dark" href={`/${lang}/login/`}>{t('Create my private space','Crear mi espacio privado')}</a><p class="caption">{t('Reception can share this page as the enrolment QR. Personal membership QR codes are separate and visible only in your account.','Recepción puede compartir esta página mediante el QR de adhesión. Los QR personales de miembro son distintos y solo aparecen en tu cuenta.')}</p></section>}
 {section==='login'&&<AuthForm lang={lang} client:only="react"/>}
 {section==='account'&&<Account lang={lang} tab={slug||'home'} stayId={extra} content={content} client:only="react"/>}
</Portal>
