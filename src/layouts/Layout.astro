---
import '../styles/reference.css';
import '../styles/app.css';
import type { Content, Locale } from '../lib/schema';
interface Props { lang: Locale; title?: string; description?: string; articleId?: string; content?: Content; noindex?: boolean; }
const { lang, title = 'El Sanctuario — ' + (Astro.props.lang === 'es' ? 'Una revista viva de La Casa Que Canta' : 'A living journal by La Casa Que Canta'), description = lang === 'en' ? 'Stories, flavours and little rituals from La Casa Que Canta and Zihuatanejo.' : 'Historias, sabores y pequeños rituales de La Casa Que Canta y Zihuatanejo.', articleId, content, noindex = false } = Astro.props;
const origin = process.env.PUBLIC_SITE_URL || Astro.url.origin;
const pathname = articleId ? `/${lang}/stories/${articleId}/` : `/${lang}/`;
const data = JSON.stringify({ lang, content }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#283d37" />
    {(noindex || process.env.PUBLIC_INDEXABLE !== 'true') && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <>
      <link rel="canonical" href={new URL(pathname, origin).href} />
      {(['en', 'es'] as const).map(l => <link rel="alternate" hreflang={l} href={new URL(articleId ? `/${l}/stories/${articleId}/` : `/${l}/`, origin).href} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(articleId ? `/en/stories/${articleId}/` : '/en/', origin).href} />
    </>}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content={articleId ? 'article' : 'website'} />
    <meta property="og:image" content={new URL(content?.articles.find(a => a.id === articleId)?.image.src || '/assets/hero.jpg', origin).href} />
    <link rel="manifest" href="/manifest.webmanifest" /><link rel="icon" href="/assets/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icon-192.png" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    {content && <script type="application/json" id="journal-data" set:html={data} />}
    {content && <script>import '../scripts/journal';</script>}
  </body>
</html>
