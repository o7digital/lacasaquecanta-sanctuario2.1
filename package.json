{
  "name": "el-sanctuario-21",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "prebuild": "node scripts/migrate-on-deploy.mjs",
    "build": "astro build && node scripts/precache.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test tests/integration/*.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:local": "docker compose up -d db"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/vercel": "^11.0.22",
    "@zxing/browser": "^0.2.1",
    "astro": "^7.4.13",
    "better-auth": "^1.7.27",
    "cheerio": "1.1.2",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@playwright/test": "^1.56.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "sharp": "^0.35.5",
    "tsx": "4.20.6",
    "turndown": "^7.2.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  }
}
